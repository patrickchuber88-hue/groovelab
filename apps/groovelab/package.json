{
  "name": "groovelab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "security:check": "node ../../scripts/security_drift_guard.mjs && node ../../scripts/verify_neutral_ausfall_invariants.mjs",
    "security:secrets": "bash ../../scripts/pre_commit_secret_scanner.sh --all",
    "security:diff": "node ../../scripts/security_diff_audit.mjs",
    "build": "tsc && vite build && node ../../scripts/inject_sri_hashes.mjs && node ../../scripts/precompress_assets.mjs && node ../../scripts/check-bundle-budget.js",
    "test:billing": "tsx src/domain/__tests__/runBillingInvariantTests.ts",
    "test:teacher-names": "tsx src/tests/runTeacherNameInvariantTests.ts",
    "gate": "node ../../scripts/security_drift_guard.mjs && node ../../scripts/verify_neutral_ausfall_invariants.mjs && bash ../../scripts/pre_commit_secret_scanner.sh --all && tsc --noEmit",
    "verify:enterprise": "npm run gate",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@supabase/supabase-js": "^2.39.3",
    "@types/jszip": "^3.4.0",
    "@yudiel/react-qr-scanner": "^2.5.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.320.0",
    "react": "^18.2.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^18.2.0",
    "react-qr-code": "^2.0.12",
    "react-router-dom": "^7.18.0",
    "react-use": "^17.6.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}

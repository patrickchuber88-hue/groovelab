# Supabase Konfiguration
# Kopiere diese Datei zu .env.local und trage deine Werte ein.
# Du findest diese Werte in deinem Supabase Dashboard unter:
# Settings -> API -> Project URL & Project API Keys (anon/public)

VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-key

# Developer Bypass Tokens for Localhost Login
VITE_BYPASS_PATRICK_HUBER_TOKEN=dein-patrick-huber-bypass-qr-token
VITE_BYPASS_ADMIN_TOKEN=dein-admin-bypass-qr-token
VITE_BYPASS_ELISABETH_ZIMMERMAN_TOKEN=deine-elisabeth-zimmerman-bypass-qr-token


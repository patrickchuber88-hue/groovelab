{
  "name": "groovelab-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:groovelab": "npm run dev -w apps/groovelab",
    "build:groovelab": "npm run build -w apps/groovelab",
    "security:check": "npm run security:check -w apps/groovelab",
    "security:secrets": "npm run security:secrets -w apps/groovelab",
    "security:diff": "npm run security:diff -w apps/groovelab",
    "test:legal": "node scripts/legal_compliance_guard.mjs",
    "legal:check": "node scripts/legal_compliance_guard.mjs",
    "test:billing": "npm run test:billing -w apps/groovelab",
    "test:teacher-names": "tsx apps/groovelab/src/tests/runTeacherNameInvariantTests.ts",
    "test:rls": "tsx tests/security/rls-isolation.test.ts",
    "test:domain": "tsx tests/unit/gobd-sepa-domain.test.ts",
    "test:api": "tsx tests/contracts/auth-rpc-fuzzing.test.ts",
    "test:pentest": "tsx tests/e2e/pentest-race-conditions.test.ts",
    "test:tier3": "tsx apps/groovelab/src/tests/test_tier3_sovereign_enterprise_forensic.ts",
    "test:forensic-optimizations": "tsx apps/groovelab/src/tests/test_forensic_optimizations_suite.ts",
    "test:pyramid": "npm run test:domain && npm run test:rls && npm run test:api && npm run test:pentest",
    "verify:invariants": "tsx scripts/verify_rls_catalog_invariants.ts",
    "typecheck": "tsc -p apps/groovelab/tsconfig.json --noEmit && tsc -p packages/shared/tsconfig.json --noEmit && tsc -p packages/bff-server/tsconfig.json --noEmit && tsc -p packages/backend-core/tsconfig.json --noEmit",
    "gate": "npm run security:check && npm run security:secrets && npm run typecheck",
    "gate:pre-commit": "npm run gate",
    "gate:fast": "node scripts/security_drift_guard.mjs && npx tsc --noEmit",
    "verify:enterprise": "npm run gate",
    "verify:headers:static": "node scripts/verify_static_security_headers.mjs",
    "verify:perimeter": "node scripts/verify_perimeter_headers.mjs",
    "check:budget": "node scripts/check-bundle-budget.js",
    "prepare": "test -d .git && husky install || exit 0"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "husky": "^8.0.0"
  }
}

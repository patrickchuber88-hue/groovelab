{
  "name": "groovelab-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:groovelab": "npm run dev -w apps/groovelab",
    "build:groovelab": "npm run build -w apps/groovelab",
    "security:check": "npm run security:check -w apps/groovelab",
    "security:secrets": "npm run security:secrets -w apps/groovelab",
    "security:diff": "npm run security:diff -w apps/groovelab",
    "test:billing": "npm run test:billing -w apps/groovelab",
    "verify:invariants": "tsx scripts/verify_rls_catalog_invariants.ts",
    "typecheck": "tsc -p apps/groovelab/tsconfig.json --noEmit",
    "gate": "npm run security:check && npm run security:secrets && npm run typecheck && npm run test:billing",
    "gate:fast": "node scripts/security_drift_guard.mjs && npx tsc --noEmit",
    "verify:enterprise": "npm run gate",
    "verify:perimeter": "node scripts/verify_perimeter_headers.mjs",
    "check:budget": "node scripts/check-bundle-budget.js",
    "prepare": "husky install"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "husky": "^8.0.0"
  }
}

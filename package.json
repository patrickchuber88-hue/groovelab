{
  "name": "groovelab-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev:groovelab",
    "dev:groovelab": "npm run dev -w apps/groovelab",
    "build:groovelab": "npm run build -w apps/groovelab",
    "security:check": "npm run security:check -w apps/groovelab",
    "security:secrets": "npm run security:secrets -w apps/groovelab",
    "security:diff": "npm run security:diff -w apps/groovelab",
    "test:legal": "npm run legal:check",
    "legal:check": "node scripts/legal_compliance_guard.mjs",
    "test:billing": "npm run test:billing -w apps/groovelab",
    "test:teacher-names": "tsx apps/groovelab/src/tests/runTeacherNameInvariantTests.ts",
    "test:roster": "tsx apps/groovelab/src/tests/runStudentRosterTests.ts",
    "test:avatars": "tsx apps/groovelab/src/tests/runAvatarResolutionTests.ts",
    "test:rls": "tsx tests/security/rls-isolation.test.ts",
    "test:checkpoint2": "tsx tests/security/zero-trust-checkpoint2.test.ts",
    "test:sentinel": "tsx tests/security/dead-letter-sentinel.test.ts",
    "test:ingress": "tsx tests/security/bff-ingress-validation.test.ts",
    "test:quota": "tsx tests/unit/client-storage-quota-resilience.test.ts",
    "test:leakage": "tsx tests/security/users-security-view-leakage.test.ts",
    "test:audio-edge": "tsx tests/security/audio-edge-streaming.test.ts",
    "test:dr": "tsx tests/security/disaster-recovery-drill.test.ts",
    "test:ingestion": "tsx tests/security/legacy-migration-ingestion.test.ts",
    "test:pentest": "tsx tests/e2e/pentest-race-conditions.test.ts",
    "test:domain": "tsx tests/unit/gobd-sepa-domain.test.ts",
    "test:api": "tsx tests/contracts/auth-rpc-fuzzing.test.ts",
    "guard:buttons": "node scripts/button_interaction_guard.mjs",
    "guard:pwa-mobile": "node scripts/pwa_mobile_architecture_guard.mjs",
    "guard:licenses": "node scripts/license_compliance_guard.mjs",
    "guard:overlap": "node scripts/zero_overlap_guard.mjs",
    "guard:iso27001": "node scripts/iso27001_compliance_guard.mjs",
    "guard:monolith-ceiling": "node scripts/monolith_growth_guard.mjs",
    "guard:shadows": "node scripts/shadow_compliance_guard.mjs",
    "guard:parent-portal": "node scripts/parent_portal_governance_guard.mjs",
    "guard:test-facade": "node scripts/test_facade_guard.mjs",
    "guard:sw": "node scripts/verify_sw_integrity.mjs",
    "guard:exocortex": "node scripts/product_bible_guard.mjs --check",
    "exocortex:snapshot": "node scripts/product_bible_guard.mjs --snapshot",
    "exocortex:restore": "node scripts/product_bible_guard.mjs --restore",
    "exocortex:list": "node scripts/product_bible_guard.mjs --list",
    "eval:agent": "node scripts/eval_agent_suite.mjs",
    "security:iso27001": "node scripts/iso27001_compliance_guard.mjs",
    "test:lifecycle": "tsx apps/groovelab/src/tests/test_audio_engine_lifecycle_forensic.ts",
    "test:journeys": "tsx apps/groovelab/src/tests/test_interactive_journeys_forensic.ts",
    "test:dashboards": "tsx scripts/run_dashboard_forensics.ts",
    "test:resilience": "tsx scripts/run_resilience_forensics.ts",
    "test:sovereign": "tsx scripts/run_sovereign_forensics.ts",
    "test:forensics:all": "npm run test:dashboards && npm run test:resilience && npm run test:sovereign",
    "test:pyramid": "npm run test:domain && npm run test:billing && npm run test:teacher-names && npm run test:roster && npm run test:avatars && npm run verify:invariants && npm run test:api && npm run test:rls && npm run test:pentest",
    "verify:invariants": "tsx scripts/verify_rls_catalog_invariants.ts && tsx scripts/verify_workspace_invariants.ts",
    "verify:workspace": "tsx scripts/verify_workspace_invariants.ts",
    "verify:worldtour": "tsx scripts/verify_world_tour_invariants.ts",
    "test:worldtour:rest": "tsx tests/unit/worldtour-rest-tablature.test.ts",
    "typecheck": "tsc -p apps/groovelab/tsconfig.json --noEmit && tsc -p packages/shared/tsconfig.json --noEmit && tsc -p packages/bff-server/tsconfig.json --noEmit && tsc -p packages/backend-core/tsconfig.json --noEmit",
    "security:deps": "npm audit --omit=dev --audit-level=critical",
    "gate": "node scripts/morning_gate_orchestrator.mjs && npm run typecheck",
    "gate:pre-commit": "bash scripts/pre_commit_secret_scanner.sh && npm run guard:iso27001 && npm run typecheck",
    "gate:pre-push": "npm run gate && npm run test:rls && npm run security:deps",
    "operator:morning": "npm run gate",
    "operator:weekly": "npx tsx scripts/export_weekly_resilience_dossier.ts",
    "operator:monthly": "npx tsx scripts/export_monthly_governance_dossier.ts",
    "operator:annual": "npx tsx scripts/export_annual_governance_dossier.ts",
    "operator:post-deploy": "npm run verify:perimeter",
    "verify:enterprise": "npm run gate && npm run test:pyramid && npm run test:forensics:all && npm run check:budget",
    "verify:headers:static": "node scripts/verify_static_security_headers.mjs",
    "verify:perimeter": "node scripts/verify_perimeter_headers.mjs",
    "check:budget": "node scripts/check-bundle-budget.js",
    "prepare": "test -d .git && husky install || exit 0"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "husky": "^8.0.0"
  },
  "overrides": {
    "proxy-addr": "^2.0.8"
  }
}
